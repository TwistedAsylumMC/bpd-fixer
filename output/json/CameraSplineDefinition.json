{
    "title": "CameraSplineDefinition",
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "/CameraSplineDefinition.json",
    "x-format-version": "MISSING VERSION",
    "x-minecraft-version": "1.26.50-beta.26",
    "x-protocol-version": 2192,
    "type": "object",
    "properties": {
        "control_points": {
            "type": "array",
            "items": {
                "$ref": "./CameraSplineControlPoint.json"
            },
            "x-ordinal-index": 3
        },
        "name": {
            "type": "string",
            "x-ordinal-index": 0,
            "pattern": "^\\w+:\\w+$"
        },
        "progress_key_frames": {
            "type": "array",
            "items": {
                "$ref": "./CameraSplineProgressKeyFrame.json"
            },
            "x-ordinal-index": 4
        },
        "rotation_key_frames": {
            "type": "array",
            "items": {
                "$ref": "./CameraSplineRotationKeyFrame.json"
            },
            "x-ordinal-index": 5
        },
        "spline_type": {
            "type": "string",
            "default": "catmullrom",
            "x-ordinal-index": 2,
            "pattern": "^(?:catmullrom|linear)$"
        },
        "total_time": {
            "type": "number",
            "x-underlying-type": "float",
            "x-ordinal-index": 1,
            "minimum": 0.0
        },
        "splineIdentifier": {
            "description": "Identifier of the spline definition.",
            "type": "string",
            "x-ordinal-index": 6
        },
        "loadFromJson": {
            "description": "Whether the spline is loaded from JSON rather than from this packet.",
            "type": "boolean",
            "x-underlying-type": "boolean",
            "x-ordinal-index": 7
        }
    },
    "required": [
        "control_points",
        "loadFromJson",
        "name",
        "progress_key_frames",
        "rotation_key_frames",
        "splineIdentifier",
        "spline_type",
        "total_time"
    ]
}